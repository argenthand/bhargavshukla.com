{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bs-blog",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Cache (#123, docs/caching.md): Cloudflare answers cached pages without running the
	// Worker. The Worker version is part of the key, so a deploy never serves pages from the last one.
	"cache": { "enabled": true },
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"routes": [{ "pattern": "bhargavshukla.com", "custom_domain": true }],
	"observability": { "enabled": true },
	// Read counts (#87, docs/view-counts.md). `vite dev` uses a local copy in .wrangler/.
	"d1_databases": [
		{
			"binding": "READS",
			"database_name": "bs-reads",
			"database_id": "666761c6-6038-4855-90af-288880ba21fe",
			"migrations_dir": "migrations"
		}
	],
	// Secrets (dashboard → Variables and Secrets): STRAPI_TOKEN, PURGE_SECRET, PREVIEW_SECRET
	// (docs/infrastructure.md).
	"vars": {
		"STRAPI_URL": "https://cms.bhargavshukla.com"
	}
}
