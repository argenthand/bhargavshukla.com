{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bs-blog",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Cache (#123, docs/caching.md): Cloudflare answers cached pages without running the
	// Worker. The Worker version is part of the key, so a deploy never serves pages from the last one.
	"cache": { "enabled": true },
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"routes": [{ "pattern": "bhargavshukla.com", "custom_domain": true }],
	"observability": { "enabled": true },
	// Read counts (#87, docs/view-counts.md). `vite dev` uses a local copy in .wrangler/.
	"d1_databases": [
		{
			"binding": "READS",
			"database_name": "bs-reads",
			"database_id": "666761c6-6038-4855-90af-288880ba21fe",
			"migrations_dir": "migrations"
		}
	],
	// The contact form (#135, docs/contact.md): three sends a minute per IP.
	"ratelimits": [
		{ "name": "CONTACT_RATE", "namespace_id": "1135", "simple": { "limit": 3, "period": 60 } }
	],
	// Secrets (dashboard → Variables and Secrets): STRAPI_TOKEN, PURGE_SECRET, PREVIEW_SECRET,
	// RESEND_API_KEY, TURNSTILE_SECRET (docs/infrastructure.md).
	"vars": {
		"STRAPI_URL": "https://cms.bhargavshukla.com",
		// The sender for contact-form mail: an address on the domain verified with Resend.
		"CONTACT_FROM": "bhargavshukla.com <form@contact.bhargavshukla.com>",
		// Turnstile's site key is public (it's in the page). Under `vite dev` the card uses the test key.
		"PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFNyN0gwdaoOkbfh"
	}
}
