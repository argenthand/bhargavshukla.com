{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bs-blog",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"routes": [{ "pattern": "bhargavshukla.com", "custom_domain": true }],
	"observability": { "enabled": true },
	// Secrets (dashboard → Variables and Secrets): STRAPI_TOKEN, PURGE_SECRET, CF_PURGE_TOKEN
	// (docs/infrastructure.md). The zone ID isn't secret; the purge API needs it.
	"vars": {
		"STRAPI_URL": "https://cms.bhargavshukla.com",
		"CF_ZONE_ID": "46d06175f04c750ead2291f34512ae4f"
	}
}
