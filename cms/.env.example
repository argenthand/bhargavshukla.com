# Copy to .env. Generate each secret with: openssl rand -base64 16
HOST=0.0.0.0
PORT=1337

# Secrets (APP_KEYS is a comma-separated list)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Relative to cms/ locally; production uses the volume path /opt/app/data/data.db
DATABASE_FILENAME=.tmp/data.db

# Uploads (#13). Leave unset locally to keep files in public/uploads.
# Production sets R2_BUCKET and R2_PUBLIC_URL in the compose file; the rest go in /opt/cms/.env.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=cms-media
# R2_PUBLIC_URL=https://media.bhargavshukla.com
