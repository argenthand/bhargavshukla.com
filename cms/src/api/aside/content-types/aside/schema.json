{
  "kind": "collectionType",
  "collectionName": "asides",
  "info": {
    "singularName": "aside",
    "pluralName": "asides",
    "displayName": "Aside",
    "description": "Short-form: a code snippet, a quote, a tip or a thought. Shown in full on /asides."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "kind": {
      "type": "enumeration",
      "enum": ["code", "quote", "tip", "thought"],
      "required": true
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "sourceAuthor": {
      "type": "string"
    },
    "sourceTitle": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "asides"
    }
  }
}
