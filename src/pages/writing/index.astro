---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingIndex from '../../components/WritingIndex.astro';
import { paginate } from '../../content';
import { getSiteContent } from '../../content/site';

const { posts, categories, settings } = await getSiteContent();
const list = paginate(posts, { page: 1, pageSize: settings.writingPageSize });
---

<BaseLayout title="Writing — Bhargav Shukla" description="Every Post, newest first.">
  <h1>Writing</h1>
  <WritingIndex list={list} posts={posts} categories={categories} pageSize={settings.writingPageSize} />
</BaseLayout>
