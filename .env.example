# Local development against the local Strapi in cms/ (npm run develop there).
# Against production content instead: .env.cms.example and `pnpm dev:cms` (#98).
# STRAPI_TOKEN: the read-only "frontend-read (local)" token from `npm run seed` in cms/.
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=
# Draft preview (#57): the same value as PREVIEW_SECRET in cms/.env. Generate with: openssl rand -hex 32
PREVIEW_SECRET=
